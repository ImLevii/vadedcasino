# SkinDeck CS2 skin trading integration
# IMPORTANT: These must be set in your deployment platform (Dokploy/Railway/Render/etc.)
# .env.local is only for local development and will NOT be used in production deployments
SKINDECK_ENABLED=true
SKINDECK_API_KEY=3c070d6951fe6aef8e6f8d976f430772b295bce9b0b2bd615b788f52e7c0de80
SKINDECK_WEBHOOK_SECRET=skindeck-webhook-secret-change-me
SKINDECK_MODE=sandbox

BASE_URL=
FRONTEND_URL=
AUTHN_URL=
JWT_SECRET=

# Frontend (Vite build-time)
VITE_SERVER_URL=
VITE_SOCKET_URL=

# Steam OAuth
STEAM_API_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local defaults used by scripts/bootstrap-local-db.js when unset:
# SQL_HOST=localhost
# SQL_USER=root
# SQL_DB=cosmicluck_local
# SQL_PASS=
SQL_HOST=
SQL_USER=
SQL_DB=
SQL_PASS=
SQL_DIALECT=
SQLITE_FILE=
# Neon / PostgreSQL (server-only; never use a VITE_ prefix for credentials).
# Set SQL_DIALECT=postgres to select this database explicitly.
DATABASE_URL=
# Optional direct Neon URL for schema bootstrap; runtime uses DATABASE_URL.
DIRECT_DATABASE_URL=
# Optional fresh development admin. Both must be set to create the account.
NEON_ADMIN_USERNAME=
NEON_ADMIN_PASSWORD=
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
LOOTABLY_PLACEMENT_ID=
LOOTABLY_POSTBACK_SECRET=
CPX_APP_ID=
CPX_SECURE_HASH=
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET=
ADURITE_API_KEY=
NODE_ENV=
PORT=

# Optional independent payment vault key (32 bytes, hex or base64).
# Admin credentials otherwise use the existing stable JWT_SECRET; no new env is required.
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_SETTINGS_KEY=
# PayPal gambling merchants require pre-approval; live payouts need Payouts API access.
PAYPAL_MODE=sandbox
PAYPAL_TEST_CLIENT_ID=
PAYPAL_TEST_CLIENT_SECRET=
PAYPAL_TEST_WEBHOOK_ID=
PAYPAL_TEST_MERCHANT_ID=
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=
PAYPAL_LIVE_WEBHOOK_ID=
PAYPAL_LIVE_MERCHANT_ID=
# Optional Stripe/Apple Pay/Cash App Pay fallbacks; credentials and modes are editable in admin.
# Register each method's webhook endpoint and save its signing secret in admin.
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_WEBHOOK_SECRET=
